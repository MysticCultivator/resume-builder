NODE_ENV=test

# Must point at a database whose name contains "test" — tests/setup.ts
# checks this (reading the name out of DATABASE_URL) and refuses to run
# otherwise, since every test truncates all app tables.
#
# Local Postgres example:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/resume_builder_test
#
# Supabase example — use a separate Supabase project, or at least a
# database name containing "test", never your real project:
#   DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres_test
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/resume_builder_test

# Set to true if the test DATABASE_URL points at Supabase.
PGSSL=false

JWT_SECRET=test_secret
