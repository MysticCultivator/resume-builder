# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# PostgreSQL connection — points at the already-provisioned database.
# The server only ever connects to this database; it never creates,
# drops, or resets it. Schema changes are applied via server/db/schema.sql.
#
# REQUIRED — the server throws a clear startup error if this is unset.
# There is no local-Postgres fallback, so a missing/unset DATABASE_URL
# fails loudly instead of silently connecting somewhere unexpected.
#
# Local Postgres example:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/resume_builder
#
# Supabase example (Project Settings → Database → Connection string → URI
# in the Supabase dashboard — use the pooler connection for most apps):
#   DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/resume_builder

# Set to true when DATABASE_URL points at Supabase or any other hosted
# Postgres that requires TLS (Supabase always does). Leave unset/false for
# local Postgres.
PGSSL=false

# JWT
JWT_SECRET=your_secure_secret_here
JWT_EXPIRES_IN=1d

# CORS — the frontend origin allowed to call this API.
CLIENT_URL=http://localhost:5173

# Auth cookie SameSite setting (Lax is the right default for this app's
# same-site dev/prod setup). Only override if you know you need to.
COOKIE_SAME_SITE=lax

# ── Client (Vite env vars must be prefixed with VITE_) ─
# Optional — defaults to the same-origin relative path `/api` if unset,
# which is what both local dev (via the Vite proxy, see client/vite.config.ts)
# and the Netlify deployment (via the /api/* redirect, see netlify.toml)
# rely on. See client/.env.example for details.
# VITE_API_BASE_URL=http://localhost:5000/api
