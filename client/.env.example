# Optional. Vite env vars must be prefixed with VITE_.
#
# Leave this unset for the normal Netlify deployment and for local dev via
# `npm run dev:client` (which proxies /api to the local server — see
# vite.config.ts) — the app defaults to the same-origin relative path
# `/api` (see client/src/services/apiClient.ts) and Netlify's `/api/*`
# redirect (netlify.toml) forwards that to the Netlify Function.
#
# Only set this if you need the frontend to call an API on a different
# origin than the one it's served from.
# VITE_API_BASE_URL=http://localhost:5000/api
